<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX manifest of Edge+, laid out beside edgeplus.exe by tools\Build-Msix.ps1,
  which stamps the version, so Cargo.toml stays its one home.

  Edge+ is a full-trust desktop app: it injects into Edge, so it needs
  runFullTrust. The package would otherwise redirect its writes under
  %LOCALAPPDATA% and HKCU into a private copy, where Edge could not find the
  split DLL and the settings the DLL reads; unvirtualizedResources with both
  virtualizations off keeps them at their real paths.

  Start at sign-in is the startup task below, toggled by the core
  (setup\start_with_windows.rs, STARTUP_TASK_ID). A task cannot pass arguments,
  so it runs the launcher, which starts the exe as a boot launch (no window).

  The publisher is the signing certificate's subject: Build-Msix.ps1 signs with
  the certificate of that name, so the two cannot drift apart.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap desktop desktop6 rescap">

  <Identity
      Name="avi12.EdgePlus"
      Publisher="CN=avi12"
      Version="0.0.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Edge+</DisplayName>
    <PublisherDisplayName>Avi</PublisherDisplayName>
    <Description>Live feature switches for Microsoft Edge</Description>
    <Logo>assets\StoreLogo.png</Logo>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="edgeplus.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Edge+"
          Description="Live feature switches for Microsoft Edge"
          Square150x150Logo="assets\Square150x150Logo.png"
          Square44x44Logo="assets\Square44x44Logo.png"
          BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask"
                           Executable="edgeplus-launcher.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="EdgePlusStartup" Enabled="false" DisplayName="Edge+" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
