<Window
    x:Class="EdgePlus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EdgePlus">

    <Grid x:Name="Root" RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0"
              ColumnDefinitions="Auto,Auto">
            <Image Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/edgeplus.ico"/>
            <TextBlock Grid.Column="1" Text="{x:Bind local:Product.Name}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,4,16,16" Spacing="4">

                <!-- One card per feature, built in code (MainWindow.xaml.cs). -->
                <StackPanel x:Name="CardList" Spacing="4"/>

                <Grid Margin="4,14,4,0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="by" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Content="{x:Bind local:Product.Author}"
                                         NavigateUri="{x:Bind local:Product.AuthorUri}" Padding="2,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind local:Product.Version}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
