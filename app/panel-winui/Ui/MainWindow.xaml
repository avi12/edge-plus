<Window
    x:Class="EdgePlus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EdgePlus">

    <!-- The whole window takes a dropped theme folder, .zip or .crx. -->
    <Grid x:Name="Root" RowDefinitions="Auto,*" AllowDrop="True"
          DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0"
              ColumnDefinitions="Auto,Auto">
            <Image Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/edgeplus.ico"/>
            <TextBlock Grid.Column="1" Text="{x:Bind local:Product.Name}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,4,16,16" Spacing="4">

                <TextBlock x:Name="OpenEdgeHint" Margin="4,0,4,4" Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- An Edge update that switched features off, or the
                     features the running build holds off. -->
                <InfoBar x:Name="BuildNotice" IsOpen="False" IsClosable="False" Severity="Warning"/>
                <!-- A local theme edit that was refused, or an action that
                     failed outside the theming card. -->
                <InfoBar x:Name="ActionNotice" IsOpen="False" IsClosable="True" Severity="Error"/>

                <!-- One card per feature, built in code. -->
                <StackPanel x:Name="CardList" Spacing="4"/>

                <Grid Margin="4,14,4,0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="by" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Content="{x:Bind local:Product.Author}"
                                         NavigateUri="{x:Bind local:Product.AuthorUri}" Padding="2,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind local:Product.Version}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Shown while a theme is dragged over the window. -->
        <Grid x:Name="DropVeil" Grid.RowSpan="2" Margin="12" Opacity="0" IsHitTestVisible="False"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Rectangle Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                       StrokeDashArray="4,3" RadiusX="8" RadiusY="8"/>
            <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12"/>
            </Grid.OpacityTransition>
        </Grid>
    </Grid>
</Window>
