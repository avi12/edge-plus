<Window
    x:Class="EdgePlus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EdgePlus">

    <Grid RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0"
              ColumnDefinitions="Auto,Auto,*">
            <Image Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                   Source="ms-appx:///Assets/edgeplus.ico"/>
            <TextBlock Grid.Column="1" Text="{x:Bind local:Product.Name}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
            <TextBlock x:Name="SwapStatus" Grid.Column="2" VerticalAlignment="Center"
                       Margin="12,0,0,0" Opacity="0" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <ContentControl x:Name="PanelSlot" Grid.Row="1" IsTabStop="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</Window>
