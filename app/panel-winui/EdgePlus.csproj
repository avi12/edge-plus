<Project Sdk="Microsoft.NET.Sdk">
  <!-- The thin host: process, single instance and window. The panel is loaded
       from Panel\EdgePlus.Panel.csproj and swapped live on rebuild; a host
       change needs a restart. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EdgePlus</RootNamespace>
    <AssemblyName>edgeplus</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Program.Main decides the kind of launch before WinUI is touched. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\edgeplus.ico</ApplicationIcon>
    <!-- Unpackaged and self-contained: full trust (so it can inject) with
         nothing to pre-install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Generates the resources.pri the single-file exe embeds. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- `dotnet publish` only: one edgeplus.exe. Unpackaged + self-contained is
       what makes PublishSingleFile legal for WinUI 3. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The panel and the tests are their own projects; the links below are the
       files both sides compile. -->
  <ItemGroup>
    <Compile Remove="Panel\**;test\**" />
    <None Remove="Panel\**;test\**" />
    <Page Remove="Panel\**;test\**" />
    <Compile Include="Panel\Platform\Packaging.cs" Link="Shared\Packaging.cs" />
    <Compile Include="Panel\Platform\Product.cs" Link="Shared\Product.cs" />
    <Compile Include="Panel\Platform\Switches.cs" Link="Shared\Switches.cs" />
  </ItemGroup>

  <!-- The panel is embedded, not referenced: a referenced type would load into
       the default context, where it could never unload. The metadata tells a
       dev run which build output to watch. -->
  <ItemGroup>
    <ProjectReference Include="Panel\EdgePlus.Panel.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CarryPanel" BeforeTargets="BeforeBuild">
    <MSBuild Projects="Panel\EdgePlus.Panel.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="PanelAssembly" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(PanelAssembly)" LogicalName="panel/edgeplus-panel.dll"
                        WithCulture="false" Type="Non-Resx" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PanelBuildOutput</_Parameter1>
        <_Parameter2>@(PanelAssembly->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RepositoryRoot</_Parameter1>
        <_Parameter2>$(RepositoryRoot)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\edgeplus.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The repo's verbs, for task runners: dotnet build app\panel-winui -t:<name>. -->
  <PropertyGroup>
    <NativeSplitDir>$(RepositoryRoot)app\native-split\</NativeSplitDir>
  </PropertyGroup>
  <Target Name="BuildNative">
    <Exec Command="&quot;$(NativeSplitDir)build.cmd&quot;" WorkingDirectory="$(NativeSplitDir)" />
  </Target>

  <Target Name="Lint">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepositoryRoot)tools\lint.ps1&quot;" />
  </Target>

  <Target Name="Test">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)test\run.cmd&quot;" />
  </Target>
</Project>
