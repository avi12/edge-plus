<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EdgePlus</RootNamespace>
    <AssemblyName>edgeplus</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Suppress the Windows App SDK's generated entry point so Program.Main can
         decide, before WinUI is ever touched, whether this launch is the
         headless dev-mode waiter or the panel. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The C# counterpart of the Tauri core's `unsafe_code = "forbid"`. Every
         Win32 call is a [DllImport] in Native\, which needs no unsafe block;
         tools\lint.ps1 fails a [DllImport] anywhere else. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\edgeplus.ico</ApplicationIcon>
    <!-- Unpackaged, self-contained, as any-stt is: a plain .exe with the
         runtime beside it, so it runs full-trust (and can inject) with nothing
         to pre-install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Needed by PublishSingleFile below: it generates the resources.pri the
         single exe embeds. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The product's identity, written once. It becomes the exe's file properties
    and the assembly attributes Product.cs reads back, so a rename or a version
    bump is this block and nothing else.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Edge+</Product>
    <Description>Live feature switches for Microsoft Edge</Description>
    <Company>Avi</Company>
    <Authors>Avi</Authors>
    <Copyright>© 2026 Avi</Copyright>
    <!-- Keep AssemblyInformationalVersion equal to <Version>: the SDK appends
         +<commit sha> by default, and Product.Version is what the footer shows. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    What `dotnet publish` produces: one edgeplus.exe and nothing beside it.
    Unpackaged + self-contained is what makes PublishSingleFile legal for WinUI
    3. None of this touches `dotnet build`, which still emits the loose folder
    the dev loop runs from.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The unit tests are their own project (test\), compiled from the pure
       sources here; the SDK's default glob would otherwise pull them in. -->
  <ItemGroup>
    <Compile Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>

  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepositoryRoot>
    <NativeSplitDir>$(RepositoryRoot)app\native-split\</NativeSplitDir>
    <SplitDll>$(NativeSplitDir)build\fixedge-split.dll</SplitDll>
  </PropertyGroup>

  <!--
    The native split DLL, carried inside the exe as a resource and unpacked by
    Payload.cs beside the settings, so the switch always injects the DLL that
    matches this build. The DLL has its own build (build.cmd, MSVC + ninja);
    like the Tauri panel's build.rs, this uses the already-built DLL and only
    runs build.cmd when it is missing — then fails with a sentence naming the
    file, rather than producing a panel that cannot do anything.
  -->
  <ItemGroup>
    <EmbeddedResource Include="$(SplitDll)" LogicalName="payload/fixedge-split.dll" />
  </ItemGroup>
  <Target Name="BuildMissingNativeSplit" BeforeTargets="BeforeBuild" Condition="!Exists('$(SplitDll)')">
    <Exec Command="&quot;$(NativeSplitDir)build.cmd&quot;" WorkingDirectory="$(NativeSplitDir)" />
  </Target>
  <Target Name="VerifyNativeSplit" AfterTargets="BuildMissingNativeSplit" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(SplitDll)')"
           Text="edgeplus carries fixedge-split.dll inside itself and cannot find it at $(SplitDll). Build it first: app\native-split\build.cmd" />
  </Target>

  <!--
    Platform\Shared.g.cs — the values the panel shares with the DLL (event
    names, the config file and its sizes, the pinned msedge.dll build),
    regenerated from the @share markers in app\native-split\src before every
    build so the two cannot drift. The file is checked in (so the project opens
    and builds in an IDE that has not run the script) and tools\lint.ps1 fails
    when the committed copy is stale.
  -->
  <Target Name="ExportSharedConstants" BeforeTargets="BeforeBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepositoryRoot)tools\Export-SharedConstants.ps1&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\edgeplus.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The repo's verbs, here because this csproj is the manifest a task runner
    reads its list from (as any-stt's is). Each is the script it names and
    nothing more:

      dotnet build app\panel-winui -t:BuildNative   the C++ split DLL
      dotnet build app\panel-winui -t:Lint          the C++ and C# lint gate
      dotnet build app\panel-winui -t:Test          the panel's pure-logic tests
  -->
  <Target Name="BuildNative">
    <Exec Command="&quot;$(NativeSplitDir)build.cmd&quot;" WorkingDirectory="$(NativeSplitDir)" />
  </Target>

  <Target Name="Lint">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepositoryRoot)tools\lint.ps1&quot;" />
  </Target>

  <Target Name="Test">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)test\run.cmd&quot;" />
  </Target>
</Project>
