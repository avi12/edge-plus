<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The host: a thin, stable exe that owns the process, the single-instance
    handling and the window (title bar, size, chrome), and loads the panel —
    every feature and the window's content — from Panel\EdgePlus.Panel.csproj
    into a collectible AssemblyLoadContext (Host\PanelLoader.cs). In a repo
    checkout a rebuild of the panel alone is swapped into the running window;
    the host itself changes rarely and needs a restart when it does.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EdgePlus</RootNamespace>
    <AssemblyName>edgeplus</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Suppress the Windows App SDK's generated entry point so Program.Main can
         decide, before WinUI is ever touched, whether this launch is the
         headless dev-mode waiter or the panel. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\edgeplus.ico</ApplicationIcon>
    <!-- Unpackaged, self-contained, as any-stt is: a plain .exe with the
         runtime beside it, so it runs full-trust (and can inject) with nothing
         to pre-install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Needed by PublishSingleFile below: it generates the resources.pri the
         single exe embeds. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    What `dotnet publish` produces: one edgeplus.exe and nothing beside it.
    Unpackaged + self-contained is what makes PublishSingleFile legal for WinUI
    3. None of this touches `dotnet build`, which still emits the loose folder
    the dev loop runs from.
  -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- The panel and the tests are their own projects; the SDK's default glob
       would otherwise pull their sources in. Product and Switches are the two
       files both sides compile. -->
  <ItemGroup>
    <Compile Remove="Panel\**;test\**" />
    <None Remove="Panel\**;test\**" />
    <Page Remove="Panel\**;test\**" />
    <Compile Include="Panel\Platform\Product.cs" Link="Shared\Product.cs" />
    <Compile Include="Panel\Platform\Switches.cs" Link="Shared\Switches.cs" />
  </ItemGroup>

  <!--
    The panel assembly, built first and carried inside the exe as a resource:
    a published edgeplus.exe loads it from there. A build in the repo also
    records where the panel project writes its output, so the host can watch it
    and swap a rebuilt panel in live (PanelLoader). The host does not reference
    the panel's types — only its entry point, by name — so nothing of the panel
    is ever loaded into the default context, where it could not be unloaded.
  -->
  <ItemGroup>
    <ProjectReference Include="Panel\EdgePlus.Panel.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CarryPanel" BeforeTargets="BeforeBuild">
    <MSBuild Projects="Panel\EdgePlus.Panel.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="PanelAssembly" />
    </MSBuild>
    <ItemGroup>
      <EmbeddedResource Include="@(PanelAssembly)" LogicalName="panel/edgeplus-panel.dll"
                        WithCulture="false" Type="Non-Resx" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PanelBuildOutput</_Parameter1>
        <_Parameter2>@(PanelAssembly->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RepositoryRoot</_Parameter1>
        <_Parameter2>$(RepositoryRoot)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\edgeplus.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The repo's verbs, here because this csproj is the manifest a task runner
    reads its list from (as any-stt's is). Each is the script it names and
    nothing more:

      dotnet build app\panel-winui -t:BuildNative   the C++ split DLL
      dotnet build app\panel-winui -t:Lint          the C++ and C# lint gate
      dotnet build app\panel-winui -t:Test          the panel's pure-logic tests
  -->
  <PropertyGroup>
    <NativeSplitDir>$(RepositoryRoot)app\native-split\</NativeSplitDir>
  </PropertyGroup>
  <Target Name="BuildNative">
    <Exec Command="&quot;$(NativeSplitDir)build.cmd&quot;" WorkingDirectory="$(NativeSplitDir)" />
  </Target>

  <Target Name="Lint">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepositoryRoot)tools\lint.ps1&quot;" />
  </Target>

  <Target Name="Test">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)test\run.cmd&quot;" />
  </Target>
</Project>
