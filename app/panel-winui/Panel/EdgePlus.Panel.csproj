<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loaded by the host into a collectible context and swapped live. Nothing
       here may subclass a WinRT type or carry compiled XAML: those register
       with WinUI process-wide and pin the context so it never unloads. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EdgePlus</RootNamespace>
    <AssemblyName>edgeplus-panel</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- WinUI and BCL references resolve to the host's copies, which is what
         lets WinRT objects cross. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- CsWinRT's AOT optimizer registers this assembly's lookups in
         WinRT.Runtime's process-wide lists, which never let go, so no panel
         context ever unloaded (dotnet-dump gcroot: the LoaderAllocator rooted
         by Object._comWrappersLock). The panel wraps none of its own types, so
         it loses nothing. -->
    <CsWinRTAotOptimizerEnabled>false</CsWinRTAotOptimizerEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <NativeSplitDir>$(RepositoryRoot)app\native-split\</NativeSplitDir>
    <SplitDll>$(NativeSplitDir)build\fixedge-split.dll</SplitDll>
  </PropertyGroup>

  <!-- The embedded split DLL is rebuilt whenever any source is newer, not only
       when it is missing: a stale one, carried silently, once replaced Edge's
       current DLL at panel start (the spine switch then did nothing). -->
  <ItemGroup>
    <EmbeddedResource Include="$(SplitDll)" LogicalName="payload/fixedge-split.dll" />
    <NativeSplitSource Include="$(NativeSplitDir)src\**\*.h;$(NativeSplitDir)src\**\*.cpp" />
    <NativeSplitSource Include="$(NativeSplitDir)fixedge-split.buildscript;$(NativeSplitDir)build.cmd" />
  </ItemGroup>
  <Target Name="BuildNativeSplit" BeforeTargets="BeforeBuild"
          Inputs="@(NativeSplitSource)" Outputs="$(SplitDll)">
    <Exec Command="&quot;$(NativeSplitDir)build.cmd&quot;" WorkingDirectory="$(NativeSplitDir)" />
  </Target>
  <Target Name="VerifyNativeSplit" AfterTargets="BuildNativeSplit" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(SplitDll)')"
           Text="edgeplus carries fixedge-split.dll inside itself and cannot find it at $(SplitDll). Build it first: app\native-split\build.cmd" />
  </Target>

  <!-- Regenerates Platform\Shared.g.cs from the DLL's @share markers so the two
       cannot drift; tools\lint.ps1 fails a stale committed copy. -->
  <Target Name="ExportSharedConstants" BeforeTargets="BeforeBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(RepositoryRoot)tools\Export-SharedConstants.ps1&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
</Project>
