<Project Sdk="Microsoft.NET.Sdk">
  <!-- No test framework, for the same supply-chain reason the UI has no
       component library. A source listed here must not touch WinUI or Win32,
       which lets this project build without the Windows App SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EdgePlus</RootNamespace>
    <AssemblyName>edgeplus-tests</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Host\PanelSource.cs" Link="Host\PanelSource.cs" />
    <Compile Include="..\Host\ResizeHandles.cs" Link="Host\ResizeHandles.cs" />
    <Compile Include="..\Panel\Dll\ConfigWire.cs" Link="Panel\ConfigWire.cs" />
    <Compile Include="..\Panel\Edge\DevModePrompt.cs" Link="Panel\DevModePrompt.cs" />
    <Compile Include="..\Panel\Edge\EdgeBuild.cs" Link="Panel\EdgeBuild.cs" />
    <Compile Include="..\Panel\Edge\EdgeInstall.cs" Link="Panel\EdgeInstall.cs" />
    <Compile Include="..\Panel\Edge\EdgeSupport.cs" Link="Panel\EdgeSupport.cs" />
    <Compile Include="..\Panel\Edge\EdgeUserData.cs" Link="Panel\EdgeUserData.cs" />
    <Compile Include="..\Panel\Edge\FileVersion.cs" Link="Panel\FileVersion.cs" />
    <Compile Include="..\Panel\Edge\LegacyData.cs" Link="Panel\LegacyData.cs" />
    <Compile Include="..\Panel\Platform\InjectOffer.cs" Link="Panel\InjectOffer.cs" />
    <Compile Include="..\Panel\Platform\PanelState.cs" Link="Panel\PanelState.cs" />
    <Compile Include="..\Panel\Platform\Paths.cs" Link="Panel\Paths.cs" />
    <Compile Include="..\Panel\Platform\Settings.cs" Link="Panel\Settings.cs" />
    <Compile Include="..\Panel\Platform\Shared.g.cs" Link="Panel\Shared.g.cs" />
    <Compile Include="..\Panel\Platform\Switches.cs" Link="Panel\Switches.cs" />
    <Compile Include="..\Panel\Setup\StartupEntry.cs" Link="Panel\StartupEntry.cs" />
    <Compile Include="..\Panel\Themes\Crx.cs" Link="Panel\Crx.cs" />
    <Compile Include="..\Panel\Themes\ExtensionId.cs" Link="Panel\ExtensionId.cs" />
    <Compile Include="..\Panel\Themes\InstalledThemes.cs" Link="Panel\InstalledThemes.cs" />
    <Compile Include="..\Panel\Themes\Protobuf.cs" Link="Panel\Protobuf.cs" />
    <Compile Include="..\Panel\Themes\StoreUrl.cs" Link="Panel\StoreUrl.cs" />
    <Compile Include="..\Panel\Themes\ThemeManifest.cs" Link="Panel\ThemeManifest.cs" />
    <Compile Include="..\Panel\Themes\ThemeOrder.cs" Link="Panel\ThemeOrder.cs" />
    <Compile Include="..\Panel\Themes\ThemePacker.cs" Link="Panel\ThemePacker.cs" />
    <Compile Include="..\Panel\Ui\KeyedList.cs" Link="Panel\KeyedList.cs" />
