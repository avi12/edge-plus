<Project>
  <!-- The product's one identity: both assemblies stamp it and Product.cs reads
       it back, so a rename or a version bump is this block alone. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Edge+</Product>
    <Description>Live feature switches for Microsoft Edge</Description>
    <Company>Avi</Company>
    <Authors>Avi</Authors>
    <Copyright>© 2026 Avi</Copyright>
    <!-- Otherwise the SDK appends +<commit sha> to the version the footer shows. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepositoryRoot>
  </PropertyGroup>
</Project>
