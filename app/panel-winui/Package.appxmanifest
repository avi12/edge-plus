<?xml version="1.0" encoding="utf-8"?>
<!--
  Used only by tools\Package-Msix.ps1's packaging publish, which also rewrites
  Version from the built exe.

  Identity/Name, Identity/Publisher and Properties/PublisherDisplayName must
  match Partner Center's "Product identity" character for character. Publisher
  is the publisher ID (CN=<guid>), not the account name. The values below are
  placeholders Partner Center refuses (docs/STORE-SUBMISSION.md).

  Full trust: the panel loads a DLL into Edge's browser process, which no
  sandboxed app can do.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap desktop desktop6 rescap">

  <Identity
      Name="avi12.PlusForEdge"
      Publisher="CN=00000000-0000-0000-0000-000000000000"
      Version="0.0.1.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Plus for Edge</DisplayName>
    <PublisherDisplayName>avi12</PublisherDisplayName>
    <Description>Live feature switches for Microsoft Edge.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Without these, the panel's writes to %LOCALAPPDATA%\FixEdge are
         redirected into its private package folder, where Edge never looks. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <!-- Same floor as TargetPlatformMinVersion in EdgePlus.csproj. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="EdgePlus" Executable="edgeplus.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Plus for Edge"
          Description="Live feature switches for Microsoft Edge."
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png"
          BackgroundColor="transparent" />
      <!-- Setup\StartWithWindows.cs names this TaskId. Launched this way the
           panel gets no arguments; Program reads the activation kind instead. -->
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="edgeplus.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="EdgePlusStartup" Enabled="false" DisplayName="Plus for Edge" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
