<!-- Edge+ under Program Files, with a Shortcuts page whose two checkboxes (both
     on by default) decide the desktop and Start menu shortcuts. A silent install
     turns one off with DESKTOPSHORTCUT="" or STARTMENUSHORTCUT="", which is how
     an installed copy's update keeps the shortcuts the user already has
     (Panel/Setup/MsiInstall.cs). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The UpgradeCode is what makes a newer MSI replace an older one: never
       change it. -->
  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="$(ProductVersion)"
           UpgradeCode="0D1704B3-FA66-40D4-8505-561EC87965CF"
           Scope="perMachine">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ProductIcon" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/avi12/edge-plus" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/avi12/edge-plus/releases" />
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />

    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="STARTMENUSHORTCUT" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductName)">
        <Component Id="Executable">
          <File Id="EdgePlusExe" Source="$(ExePath)" Name="edgeplus.exe" KeyPath="yes" />
          <!-- How a running copy knows the MSI installed it, and so updates
               through a newer MSI: MsiInstall.cs reads this key. -->
          <RegistryValue Root="HKLM" Key="Software\EdgePlus" Name="InstallDir"
                         Type="string" Value="[INSTALLFOLDER]" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Condition="STARTMENUSHORTCUT">
        <Shortcut Id="StartMenuShortcut" Name="$(ProductName)" Target="[#EdgePlusExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\EdgePlus" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOPSHORTCUT">
        <Shortcut Id="DesktopShortcut" Name="$(ProductName)" Target="[#EdgePlusExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\EdgePlus" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="Executable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch $(ProductName)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchApplication" FileRef="EdgePlusExe" ExeCommand=""
                  Return="asyncNoWait" Impersonate="yes" />

    <UI Id="EdgePlusUI">
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

      <!-- No license page: the stock Next and Back skip it. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Order="2" />

      <!-- The Shortcuts page sits between the folder and the confirmation: a
           later NewDialog on the same button wins over the stock one. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg"
               Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg"
               Order="5" Condition="NOT Installed" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Choose where [ProductName] gets a shortcut." />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="60" Width="330"
                 Height="18" CheckBoxValue="1" Property="DESKTOPSHORTCUT"
                 Text="Create a shortcut on the &amp;desktop" />
        <Control Id="StartMenuShortcutCheckBox" Type="CheckBox" X="20" Y="84" Width="330"
                 Height="18" CheckBoxValue="1" Property="STARTMENUSHORTCUT"
                 Text="Create a shortcut in the &amp;Start menu" />
      </Dialog>
    </UI>
  </Package>
</Wix>
