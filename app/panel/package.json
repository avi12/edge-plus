{
  "name": "edgeplus-panel",
  "private": true,
  "description": "Edge+ - the panel: a Tauri core in Rust and a WinUI 3 window drawn from TypeScript",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#src/*.ts": "./ui/*.ts",
    "#src/*.svelte": "./ui/*.svelte",
    "#src/*.json": "./ui/*.json",
    "#scripts/*.ts": "./scripts/*.ts",
    "#test/*.ts": "./test/*.ts"
  },
  "scripts": {
    "restore": "winapp restore",
    "bindings": "winapp node generate-bindings",
    "app": "cargo run --manifest-path src-tauri/Cargo.toml",
    "dev": "node --disable-warning=ExperimentalWarning ui/dev/dev-server.ts",
    "dev:sandbox": "node --disable-warning=ExperimentalWarning ui/dev/dev-server.ts --sandbox",
    "build:window": "node --disable-warning=ExperimentalWarning scripts/build-window.ts",
    "build": "pnpm build:window && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:js": "avi12-lint --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "lint": "pnpm lint:js && pnpm lint:rust && pnpm check && pnpm fallow",
    "lint:verify": "avi12-lint && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && pnpm check && pnpm fallow",
    "test:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop/on-desktop.ps1 -Log .verify/test-windows.log -Arguments \"--test --test-timeout=600000 test/window.test.ts\"",
    "test:js": "node --disable-warning=ExperimentalWarning --test --test-timeout=120000 \"ui/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test": "pnpm test:js && pnpm test:rust",
    "fallow": "fallow audit --base HEAD"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@winapp/bindings": "link:.winapp/bindings",
    "svelte": "5.56.7",
    "winui-svelte": "0.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.23",
    "@microsoft/winappcli": "0.7.1",
    "@types/node": "^24.10.0",
    "avi12-lint": "github:avi12/lint-config#v0.4.11&path:/packages/avi12-lint",
    "esbuild": "~0.25.12",
    "eslint": "^10.12.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.11&path:/packages/eslint-config",
    "eslint-plugin-svelte": "^3.23.1",
    "fallow": "2.103.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.11&path:/packages/fallow-config",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.11&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.11&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.11&path:/packages/oxlint-plugin-naming",
    "postcss": "^8.5.31",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.11&path:/packages/stylelint-config",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
