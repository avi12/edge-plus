<Window
    x:Class="FixEdge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FixEdge">

    <Grid RowDefinitions="Auto,*">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0"
              ColumnDefinitions="Auto,Auto">
            <FontIcon Grid.Column="0" Glyph="&#xF0E2;" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{x:Bind local:Product.Name}" VerticalAlignment="Center"
                       Margin="10,0,0,0" Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,4,16,16" Spacing="4">

                <TextBlock Margin="4,10,4,2" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Features"/>

                <!-- One switch per app-managed feature, built in code. -->
                <StackPanel x:Name="FeatureList" Spacing="4"/>

                <Grid Margin="4,14,4,0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="by" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Content="{x:Bind local:Product.Author}"
                                         NavigateUri="{x:Bind local:Product.AuthorUri}" Padding="2,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind local:Product.Version}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
