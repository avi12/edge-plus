<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FixEdge</RootNamespace>
    <AssemblyName>fixedge</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Program.Main owns the entry point: before WinUI is touched it checks for
         the quiet-dev-mode waiter switch and, if set, waits and exits. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Unpackaged and self-contained, as any-stt is: a plain exe with nothing
         to pre-install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- The product's identity, written once and read back by Product.cs. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Fix Edge</Product>
    <Description>Live feature switches for Microsoft Edge</Description>
    <Company>Avi</Company>
    <Authors>Avi</Authors>
    <Copyright>© 2026 Avi</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- The native split DLL (app\native-split), built with MSVC and carried
       inside the exe for NativeSplitPayload to unpack and the panel to inject
       into Edge. -->
  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepositoryRoot>
    <NativeSplitDir>$(RepositoryRoot)app\native-split\</NativeSplitDir>
  </PropertyGroup>
  <Target Name="BuildNativeSplit" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeSplit)' != 'true'">
    <Exec Command="&quot;$(NativeSplitDir)build.cmd&quot;" WorkingDirectory="$(NativeSplitDir)" />
    <ItemGroup>
      <EmbeddedResource Include="$(NativeSplitDir)build\fixedge-split.dll" LogicalName="fixedge-split.dll" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.*" />
  </ItemGroup>
</Project>
