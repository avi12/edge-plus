<Application
    x:Class="FixEdge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The toolkit drops a card's control under its text below this
                 width; the panel's cards are narrower than its default, and a
                 switch belongs beside the words it switches. -->
            <x:Double x:Key="SettingsCardWrapThreshold">360</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
