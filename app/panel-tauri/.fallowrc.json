{
  "$schema": "./node_modules/fallow/schema.json",
  // The window's entry points: the core starts main.ts, main.ts starts the
  // worker by URL, and ui/dev holds the stand-in core for working on the
  // window alone. Run from source, main.ts and the worker import the dev
  // server's two ends by name, so the window kit leaves Vite out.
  "entry": [
    "ui/main.ts",
    "ui/window/worker.ts",
    "ui/dev/fixture.ts",
    "ui/dev/window-modules.ts",
    "ui/dev/hot-window.ts",
    "eslint.config.js"
  ],
  "ignorePatterns": [".winapp/**", "src-tauri/**"],
  // Run by package.json scripts, which dependency scanning can't see through.
  "ignoreDependencies": ["@microsoft/winappcli", "@microsoft/dynwinrt-codegen", "oxlint-tsgolint", "postcss-html", "stylelint-config-ccb"],
  // As avi/youtube-time-manager: no coverage is fed to fallow, so CRAP is
  // cyclomatic squared plus cyclomatic; the cognitive limit does the work. The
  // local ESLint rules are tooling, not the window.
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000,
    "ignore": ["eslint-rules/**"]
  }
}
