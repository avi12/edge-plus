{
  "name": "edgeplus-panel",
  "private": true,
  "description": "Edge+ - the panel: a Tauri core in Rust and a WinUI 3 window drawn from TypeScript",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "restore": "winapp restore",
    "bindings": "winapp node generate-bindings",
    "app": "cargo run --manifest-path src-tauri/Cargo.toml",
    "window": "node --disable-warning=ExperimentalWarning ui/dev/fixture.ts",
    "build:window": "node --disable-warning=ExperimentalWarning scripts/build-window.ts",
    "build": "pnpm build:window && cargo build --release --manifest-path src-tauri/Cargo.toml",
    "check": "tsc --noEmit",
    "lint:js": "oxlint --type-aware --fix && eslint --fix .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "lint:package": "pnpm --dir ../../packages/svelte-winui lint",
    "lint": "pnpm lint:js && pnpm lint:rust && pnpm check && pnpm fallow && pnpm lint:package",
    "lint:verify": "oxlint --type-aware && eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --all --check && pnpm check && pnpm fallow && pnpm lint:package",
    "test:js": "node --disable-warning=ExperimentalWarning --test \"ui/**/*.test.ts\" && pnpm --dir ../../packages/svelte-winui test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test": "pnpm test:js && pnpm test:rust",
    "fallow": "fallow audit --base HEAD"
  },
  "imports": {
    "#winui/*": {
      "types": "./.winapp/bindings/*.d.ts",
      "default": "./.winapp/bindings/*.js"
    }
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@winapp/bindings": "link:.winapp/bindings",
    "svelte": "https://pkg.pr.new/svelte@18042",
    "svelte-winui": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.23",
    "@microsoft/winappcli": "0.7.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.0",
    "esbuild": "~0.25.12",
    "eslint": "^10.12.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "fallow": "2.103.0",
    "globals": "^17.13.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4"
  },
