# Git hooks run under sh; CRLF would break the shebang and the exec line.
.githooks/* text eol=lf

# rustfmt.toml asks for Unix newlines; core.autocrlf would check Rust out as CRLF.
*.rs text eol=lf
# Written by cargo test with LF; a CRLF checkout shows it as changed after every run.
app/panel-tauri/ui/protocol.g.ts text eol=lf
