{
  "name": "svelte-winui",
  "version": "0.0.0",
  "private": true,
  "description": "WinUI 3 controls as Svelte components: native Windows apps in Svelte, for Tauri, Electron or Node",
  "keywords": [
    "svelte",
    "winui",
    "winui3",
    "windows",
    "native",
    "desktop",
    "windows-app-sdk",
    "tauri",
    "electron"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "svelte-winui": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./state": "./src/state/index.ts",
    "./state/host": "./src/state/host.ts",
    "./host": "./src/renderer/host.ts",
    "./keyed-list": "./src/renderer/keyed-list.ts",
    "./css": "./src/css/index.ts",
    "./css/vite": "./src/css/vite.ts",
    "./css/sheet-module": "./src/css/sheet-module.ts",
    "./vite": "./src/vite/index.ts",
    "./runner": "./src/vite/runner.ts",
    "./compile": "./src/vite/compile.ts",
    "./testing": "./src/vite/loader.ts",
    "./bootstrap": "./src/window/bootstrap.ts",
    "./thread": "./src/window/thread.ts",
    "./window": "./src/window/index.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#winui/*": "@winapp/bindings/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "./dist/components/runtime.js",
    "./src/components/runtime.ts"
  ],
  "publishConfig": {
    "bin": {
      "svelte-winui": "./dist/cli/main.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "svelte": "./dist/components/index.js",
        "default": "./dist/components/index.js"
      },
      "./state": {
        "types": "./dist/state/index.d.ts",
        "svelte": "./dist/state/index.js",
        "default": "./dist/state/index.js"
      },
      "./state/host": {
        "types": "./dist/state/host.d.ts",
        "default": "./dist/state/host.js"
      },
      "./host": {
        "types": "./dist/renderer/host.d.ts",
        "svelte": "./dist/renderer/host.js",
        "default": "./dist/renderer/host.js"
      },
      "./keyed-list": {
        "types": "./dist/renderer/keyed-list.d.ts",
        "svelte": "./dist/renderer/keyed-list.js",
        "default": "./dist/renderer/keyed-list.js"
      },
      "./css": {
        "types": "./dist/css/index.d.ts",
        "default": "./dist/css/index.js"
      },
      "./css/vite": {
        "types": "./dist/css/vite.d.ts",
        "default": "./dist/css/vite.js"
      },
      "./css/sheet-module": {
        "types": "./dist/css/sheet-module.d.ts",
        "default": "./dist/css/sheet-module.js"
      },
      "./vite": {
        "types": "./dist/vite/index.d.ts",
        "default": "./dist/vite/index.js"
      },
      "./runner": {
        "types": "./dist/vite/runner.d.ts",
        "default": "./dist/vite/runner.js"
      },
      "./compile": {
        "types": "./dist/vite/compile.d.ts",
        "default": "./dist/vite/compile.js"
      },
      "./testing": {
        "types": "./dist/vite/loader.d.ts",
        "default": "./dist/vite/loader.js"
      },
      "./bootstrap": {
        "types": "./dist/window/bootstrap.d.ts",
        "default": "./dist/window/bootstrap.js"
      },
      "./thread": {
        "types": "./dist/window/thread.d.ts",
        "default": "./dist/window/thread.js"
      },
      "./window": {
        "types": "./dist/window/index.d.ts",
        "svelte": "./dist/window/index.js",
        "default": "./dist/window/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning scripts/pack/build.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint --type-aware && eslint . && pnpm check && pnpm fallow && pnpm gen:components:check",
    "fallow": "fallow",
    "gen:components": "node --disable-warning=ExperimentalWarning scripts/codegen/generate.ts --project ../../app/panel-tauri",
    "gen:components:check": "node --disable-warning=ExperimentalWarning scripts/codegen/generate.ts --project ../../app/panel-tauri --check",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\" test/mount-all.test.ts",
    "test:windows": "node --disable-warning=ExperimentalWarning --test test/lists.test.ts test/window.test.ts"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1"
  },
  "peerDependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@winapp/bindings": "*",
    "svelte": "*",
    "vite": "8.x"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@types/node": "^24.10.0",
    "@winapp/bindings": "link:../../app/panel-tauri/.winapp/bindings",
    "eslint": "^10.12.0",
    "fallow": "2.103.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "svelte": "https://pkg.pr.new/svelte@18042",
    "svelte-winui": "link:.",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  }
}
