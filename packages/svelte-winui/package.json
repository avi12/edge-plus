{
  "name": "svelte-winui",
  "version": "0.0.0",
  "private": true,
  "description": "WinUI 3 controls as Svelte components: native Windows apps in Svelte, for Tauri, Electron or Node",
  "license": "Apache-2.0",
  "type": "module",
  "os": ["win32"],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/renderer/host.ts",
    "./keyed-list": "./src/renderer/keyed-list.ts",
    "./state": "./src/state/index.ts",
    "./css": "./src/css/index.ts",
    "./css/vite": "./src/css/vite.ts",
    "./css/sheet-module": "./src/css/sheet-module.ts",
    "./vite": "./src/vite/index.ts",
    "./runner": "./src/vite/runner.ts",
    "./compile": "./src/vite/compile.ts",
    "./testing": "./src/vite/loader.ts",
    "./bootstrap": "./src/window/bootstrap.ts",
    "./thread": "./src/window/thread.ts",
    "./window": "./src/window/index.ts"
  },
  "imports": {
    "#winui/*": "@winapp/bindings/*"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint --type-aware && eslint . && pnpm check && pnpm fallow",
    "fallow": "fallow audit --base HEAD",
    "gen:components": "node --disable-warning=ExperimentalWarning scripts/codegen/generate.ts --project ../../app/panel-tauri",
    "gen:components:check": "node --disable-warning=ExperimentalWarning scripts/codegen/generate.ts --project ../../app/panel-tauri --check",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@winapp/bindings": "*",
    "svelte": "*"
  },
  "devDependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "@types/node": "^24.10.0",
    "@winapp/bindings": "link:../../app/panel-tauri/.winapp/bindings",
    "eslint": "^10.12.0",
    "fallow": "2.103.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "svelte": "https://pkg.pr.new/svelte@18042",
    "typescript": "^6.0.3"
  }
}
